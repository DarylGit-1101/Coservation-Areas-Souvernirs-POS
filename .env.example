APP_NAME="Conservation Areas Souvenirs POS"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=pos_db
DB_USERNAME=pos_user
DB_PASSWORD=pos_secret

REDIS_HOST=redis
REDIS_PORT=6379

# Set OPCACHE_VALIDATE_TIMESTAMPS=0 in production for maximum PHP throughput
OPCACHE_VALIDATE_TIMESTAMPS=1
OPCACHE_REVALIDATE_FREQ=2
